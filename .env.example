# LLM
LLM_MODEL=groq/openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/crm_enquiries.db

# SuiteCRM
SUITECRM_BASE_URL=https://crm.example.com
SUITECRM_CLIENT_ID=
SUITECRM_CLIENT_SECRET=
SUITECRM_USERNAME=
SUITECRM_PASSWORD=
SUITECRM_MOCK=true

# Email (M365 Graph)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
OUTBOUND_FROM_EMAIL=sales@glancyfawcett.com
EMAIL_MOCK=true

# Calendar
CALENDAR_USER_EMAIL=
DEFAULT_MEETING_DURATION_MINUTES=60
AVAILABILITY_LOOKAHEAD_DAYS=14
CALENDAR_MOCK=true

# Fathom
FATHOM_API_KEY=
FATHOM_WEBHOOK_SECRET=
FATHOM_MOCK=true

# Knowledge Base
CHROMA_PERSIST_DIR=./data/chroma
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_DIR=./knowledge/glancy_faq

# App
API_KEY=dev-api-key-change-me
JWT_SECRET=dev-jwt-secret-change-me
APPROVAL_NOTIFY_EMAIL=
APP_ENV=development
LOG_LEVEL=INFO
